<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RD3 - Espor Slot Alma</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #0f1117;
            color: #ffffff;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            width: 100%;
            max-width: 600px;
            background: #1a1d24;
            border: 1px solid #2a2e39;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }
        h1 {
            text-align: center;
            color: #ff4655;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        p.subtitle {
            text-align: center;
            color: #8b949e;
            margin-bottom: 25px;
            font-size: 14px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            color: #c9d1d9;
        }
        input, select {
            width: 100%;
            padding: 12px;
            background: #0f1117;
            border: 1px solid #30363d;
            border-radius: 6px;
            color: #fff;
            font-size: 15px;
            outline: none;
        }
        input:focus, select:focus {
            border-color: #ff4655;
        }
        button {
            width: 100%;
            padding: 14px;
            background-color: #ff4655;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 10px;
        }
        button:hover {
            background-color: #e03e4d;
        }
        .slot-list {
            margin-top: 30px;
            border-top: 1px solid #2a2e39;
            padding-top: 20px;
        }
        .slot-list h3 {
            margin-bottom: 15px;
            color: #c9d1d9;
        }
        .slot-item {
            display: flex;
            justify-content: space-between;
            background: #0f1117;
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 8px;
            border: 1px solid #21262d;
            font-size: 14px;
        }
        .slot-number {
            font-weight: bold;
            color: #ff4655;
        }
        .slot-team {
            color: #8b949e;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>RD3 ESPOR</h1>
    <p class="subtitle">Scrim & Turnuva Slot Kayıt Sistemi</p>

    <form id="slotForm">
        <div class="form-group">
            <label for="teamName">Takım Adı:</label>
            <input type="text" id="teamName" placeholder="Örn: RD3 Esports" required>
        </div>

        <div class="form-group">
            <label for="captainContact">Kaptan Discord / Telefon:</label>
            <input type="text" id="captainContact" placeholder="Örn: Kullanici#0000" required>
        </div>

        <div class="form-group">
            <label for="slotSelect">Slot Seçin:</label>
            <select id="slotSelect" required>
                <!-- JavaScript ile dolacak -->
            </select>
        </div>

        <button type="submit">Slotu Rezerve Et</button>
    </form>

    <div class="slot-list">
        <h3>Mevcut Slot Durumu</h3>
        <div id="slotsContainer">
            <!-- JavaScript ile sıralanacak -->
        </div>
    </div>
</div>

<script>
    const totalSlots = 16;
    let registeredSlots = {};

    function updateSlotUI() {
        const select = document.getElementById('slotSelect');
        const container = document.getElementById('slotsContainer');
        
        select.innerHTML = '';
        container.innerHTML = '';

        for (let i = 1; i <= totalSlots; i++) {
            const isTaken = registeredSlots[i];
            
            // Select menüsü için güncelleme (sadece boş slotlar)
            if (!isTaken) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = `Slot ${i} (Boş)`;
                select.appendChild(option);
            }

            // Liste görünümü
            const div = document.createElement('div');
            div.className = 'slot-item';
            div.innerHTML = `
                <span class="slot-number">SLOT ${i}</span>
                <span class="slot-team">${isTaken ? isTaken.teamName : 'BOŞ'}</span>
            `;
            container.appendChild(div);
        }

        if (select.children.length === 0) {
            const option = document.createElement('option');
            option.textContent = 'Tüm slotlar dolu!';
            select.appendChild(option);
            select.disabled = true;
        }
    }

    document.getElementById('slotForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const teamName = document.getElementById('teamName').value;
        const captainContact = document.getElementById('captainContact').value;
        const selectedSlot = document.getElementById('slotSelect').value;

        if (!selectedSlot || registeredSlots[selectedSlot]) return;

        registeredSlots[selectedSlot] = {
            teamName: teamName,
            contact: captainContact
        };

        alert(`Tebrikler! ${teamName} takımı için Slot ${selectedSlot} başarıyla alındı.`);
        
        document.getElementById('teamName').value = '';
        document.getElementById('captainContact').value = '';
        
        updateSlotUI();
    });

    // İlk açılışta liste oluştur
    updateSlotUI();
</script>

</body>
</html>
